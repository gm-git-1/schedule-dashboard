   "tags": [],
   "pub": "2026-10-07"
  },
  {
   "id": "talks:2026-10-05-tds-orientation/",
   "routine": "talks",
   "date": "archive",
   "title": "Get the Job Done — and Verify It",
   "url": "https://sanand0.github.io/talks/2026-10-05-tds-orientation/",
   "page": "talks/archive#t-2026-10-05-tds-orientation",
   "thumb": {},
   "summary": "TDS treats exams as the curriculum and agents as executors: students learn to specify, orchestrate, collaborate, notice, adapt and verify while the tools keep changing.",
   "channel": "Tools in Data Science — Sep 2026 Orientation, Remote",
   "tags": [],
   "pub": "2026-10-05"
  },
  {
   "id": "talks:2026-10-01-use-ai-emperically/",
   "routine": "talks",
   "date": "archive",
   "title": "Let's Test: Use AI Empirically",
   "url": "https://sanand0.github.io/talks/2026-10-01-use-ai-emperically/",
   "page": "talks/archive#t-2026-10-01-use-ai-emperically",
   "thumb": {},
   "summary": "Treat AI advice, models and agent workflows as hypotheses: test them on your own work, mine your logs for evidence, and make verification part of the workflow.",
   "channel": "DBS Technology India — TechVerse Session 4: Agentic AI, Remo",
   "tags": [],
   "pub": "2026-10-01"
  },
  {
   "id": "talks:2026-09-24-iis-ph-evidence-to-impact/",
   "routine": "talks",
   "date": "archive",
   "title": "If You're Too Excited, Don't Forget to Verify",
   "url": "https://sanand0.github.io/talks/2026-09-24-iis-ph-evidence-to-impact/",
   "page": "talks/archive#t-2026-09-24-iis-ph-evidence-to-impact",
   "thumb": {},
   "summary": "AI is too weird and fast-moving to trust by intuition alone: question advice, verify with a second model, calibrate confidence, benchmark what matters, and turn surviving evidence into deterministic rules.",
   "channel": "International IT-BPM Summit (IIS) 2026, Function Rooms #1 & ",
   "tags": [],
   "pub": "2026-09-24"
  },
  {
   "id": "talks:2026-09-19-shree-niketan-schools/",
   "routine": "talks",
   "date": "archive",
   "title": "Even the AI Guy Couldn't Find the Chat Button",
   "url": "https://sanand0.github.io/talks/2026-09-19-shree-niketan-schools/",
   "page": "talks/archive#t-2026-09-19-shree-niketan-schools",
   "thumb": {},
