   "id": "talks:2026-10-07-iitm-ed-data-visualization/",
   "routine": "talks",
   "date": "archive",
   "title": "Looks Right. Isn't.",
   "url": "https://sanand0.github.io/talks/2026-10-07-iitm-ed-data-visualization/",
   "page": "talks/archive#t-2026-10-07-iitm-ed-data-visualization",
